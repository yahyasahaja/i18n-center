PORT=8080
ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=i18n_user
DB_PASSWORD=i18n_password
DB_NAME=i18n_center
# DB_SSLMODE: MySQL semantics — disable | require | verify-ca | verify-full.
# Mapped to go-sql-driver/mysql's `tls` param inside database.buildDSN.
DB_SSLMODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=your-secret-key-change-in-production-min-32-characters-long
JWT_EXPIRY=24h
OPENAI_API_KEY=
CORS_ORIGIN=http://localhost:3000

LOG_SQL=false

# Datadog Observability
DD_ENABLED=false
DD_AGENT_HOST=localhost
DD_DOGSTATSD_PORT=8125

DD_METRIC_LATENCY_ENABLED=true
